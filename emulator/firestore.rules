rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bookmarks/{userId}/items/{item} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /keys/{userId}/items/{item} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /authenticator/{userId}/items/{item} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /notes/{userId}/items/{item} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /tasks/{userId}/items/{item} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /work/{userId}/tickets/{item} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /breadcrumbs/{userId}/items/{item} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /temp/{userId}/items/{item} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /categories/{userId}/items/{item} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
